# ==========================================
# CONFIGURATION SERVEUR VicozWorld
# Copiez ce fichier en .env et remplissez les valeurs
# ⚠️  NE JAMAIS committer le .env avec de vraies valeurs !
# ==========================================

# 🌐 Paramètres Généraux
TZ=Europe/Paris

# 🔒 CORS — Origines autorisées (séparées par des virgules)
# Pour le développement local, ajoutez : http://localhost:3000
ALLOWED_ORIGINS=https://vw.vicopetit.dedyn.io

# 🎬 Mon Letterboxd
# Clé API The Movie Database (TMDB) pour les affiches et métadonnées
VITE_TMDB_API_KEY=votre_cle_tmdb_ici

# 📧 Assistant Gmail IA & Gemini
# Clé Google Gemini (Gratuite sur https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=votre_cle_gemini_ici

# Identifiants Gmail (Utiliser un Mot de passe d'application Google)
# ⚠️  GMAIL_USER et GMAIL_APP_PASSWORD sont désormais dépréciés — utiliser les noms ci-dessous
GMAIL_EMAIL=votre.adresse@gmail.com
GMAIL_PASSWORD=abcd efgh ijkl mnop

# ⚡ Enedis / MyElectricalData (Optionnel)
# Identifiant PDL (Point de Livraison)
ENEDIS_PDL=
# Token d'accès MyElectricalData (https://www.myelectricaldata.fr/)
ENEDIS_TOKEN=votre_token_ici

# 🔐 Chiffrement de la base de données (Généré avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
DB_ENCRYPTION_KEY=votre_clef_fernet_ici

# 🏠 Home Assistant & Prise Connectée (TP-Link P100)
# URL locale ou publique de votre instance Home Assistant (ex: http://homeassistant.local:8123)
HASS_URL=
# Jeton d'accès longue durée (généré dans Profil Home Assistant > Sécurité > Jetons d'accès longue durée)
HASS_TOKEN=
# Identifiant de l'entité Home Assistant de la prise (défaut : switch.prise_serveur)
HASS_PLUG_ENTITY_ID=switch.prise_serveur

